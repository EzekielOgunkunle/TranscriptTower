# GitHub to Notion Sync Configuration
# Copy this file to .env and fill in your actual tokens

# GitHub Personal Access Token
# Get one from: https://github.com/settings/tokens
# Required scope: 'repo' (for private repos) or 'public_repo' (for public only)
GITHUB_TOKEN=your_github_token_here

# Notion Integration Token
# Get one from: https://www.notion.so/my-integrations
NOTION_TOKEN=your_notion_token_here

# Option 1: Use existing Notion database
# Find database ID in the database URL after notion.so/
NOTION_DATABASE_ID=your_database_id_here

# Option 2: Create new database (use instead of NOTION_DATABASE_ID)
# Find page ID in the page URL after notion.so/
# NOTION_PAGE_ID=your_page_id_here

# Optional: Specify GitHub username (defaults to authenticated user)
# GITHUB_USERNAME=specific_username
